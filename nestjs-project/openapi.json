    "/videos": {
      "post": {
        "description": "Pre-registers the video as a draft on the caller's channel and opens the multipart upload in storage.",
        "operationId": "VideosController_initiateUpload",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InitiateUploadDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Draft created and multipart upload opened",
