            "description": "Redirect to the presigned download URL",
            "headers": {
              "Location": {
                "description": "Presigned GET URL (expires in 900 s)",
                "schema": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "example": "no-store"
                }
